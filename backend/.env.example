# ─── Vapi Configuration ───────────────────────────────────────────────────────
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=

# ─── App Configuration ────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# ─── Optional: Webhook Base URL (for receiving call status updates) ───────────
# Set this to your public URL when deploying (e.g. via ngrok for local testing)
WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok.io
